# Copier ce fichier en .env (jamais versionné) et remplir les valeurs.
PORT=3001
# RPC Solana : le réseau de test (devnet) par défaut
SOLANA_RPC_URL=https://api.devnet.solana.com
# Clé privée du portefeuille créateur, réservée au devnet
WALLET_PRIVATE_KEY=
# Hébergement IPFS des images et métadonnées (pinata.cloud)
PINATA_API_KEY=
PINATA_SECRET_KEY=
# Lecture de l'explorateur Solana (firecrawl.dev)
FIRECRAWL_API_KEY=
# Optionnel
PYTHON_PATH=python3
SUDO_PASSWORD=
